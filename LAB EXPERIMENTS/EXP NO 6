menu = {
    "Pizza": 250,
    "Burger": 120,
    "Sandwich": 100
}

def add_food(food):
    if food in menu:
        return "Food Added Successfully"
    return "Food Not Available"


def calculate_bill(food):
    if food in menu:
        return menu[food]
    return 0


print(add_food("Pizza"))
print(add_food("Burger"))
print("Pizza Price:", calculate_bill("Pizza"))
print("Order Confirmed")
print("Payment Successful")
