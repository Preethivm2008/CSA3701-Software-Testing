from locust import HttpUser, task, between

class RegistrationUser(HttpUser):

    wait_time = between(1, 2)

    @task
    def register_user(self):

        payload = {
            "name": "John",
            "email": "john123@example.com",
            "password": "John@123"
        }

        with self.client.post(
            "/api/register",
            json=payload,
            catch_response=True
        ) as response:

            if response.status_code in (200, 201):
                response.success()
                print("Registration Successful")

            else:
                response.failure("Registration Failed")

    @task
    def invalid_registration(self):

        payload = {
            "name": "",
            "email": "invalid-email",
            "password": "123"
        }

        with self.client.post(
            "/api/register",
            json=payload,
            catch_response=True
        ) as response:

            if response.status_code in (400, 422):
                response.success()
                print("Invalid Input Rejected Successfully")

            else:
                response.failure("Invalid Input Validation Failed")
