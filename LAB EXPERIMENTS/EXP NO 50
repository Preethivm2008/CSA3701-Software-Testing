from locust import HttpUser, task, between

class GovernmentWebsiteUser(HttpUser):

    wait_time = between(1, 3)

    @task(3)
    def homepage(self):

        with self.client.get(
            "/",
            name="Homepage",
            catch_response=True
        ) as response:

            if response.status_code == 200:
                response.success()
                print("Homepage Available")
            else:
                response.failure("Homepage Failed")

    @task(2)
    def login_page(self):

        with self.client.get(
            "/login",
            name="Login Page",
            catch_response=True
        ) as response:

            if response.status_code == 200:
                response.success()
                print("Login Page Available")
            else:
                response.failure("Login Page Failed")

    @task(1)
    def service_page(self):

        with self.client.get(
            "/services",
            name="Services Page",
            catch_response=True
        ) as response:

            if response.status_code == 200:
                response.success()
                print("Services Page Available")
            else:
                response.failure("Services Page Failed")
