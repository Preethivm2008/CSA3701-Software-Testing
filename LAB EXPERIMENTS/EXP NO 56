from locust import HttpUser, task, between

class CapacityUser(HttpUser):

    wait_time = between(1, 2)

    @task
    def homepage(self):

        with self.client.get(
            "/",
            catch_response=True
        ) as response:

            if response.status_code == 200:
                response.success()
                print("Server Working")
            else:
                response.failure("Server Overloaded")
