import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.Test;

class SumDigitsTest {

    int sumDigits(int n) {
        n = Math.abs(n);
        int sum = 0;

        while (n != 0) {
            sum += n % 10;
            n /= 10;
        }

        return sum;
    }

    @Test
    void testSum() {
        assertEquals(15, sumDigits(12345));
        assertEquals(6, sumDigits(123));
        assertEquals(0, sumDigits(0));
        assertEquals(9, sumDigits(-234));
    }
}
