from locust import HttpUser, task, between

class FileTestUser(HttpUser):

    wait_time = between(1, 2)

    @task
    def upload_file(self):

        file_data = b"A" * (1024 * 1024)

        files = {
            "file": ("test.txt", file_data, "text/plain")
        }

        with self.client.post(
            "/upload",
            files=files,
            catch_response=True
        ) as response:

            if response.status_code in (200, 201):
                response.success()
                print("File Uploaded")
            else:
                response.failure("Upload Failed")

    @task
    def download_file(self):

        with self.client.get(
            "/download/test.txt",
            catch_response=True
        ) as response:

            if response.status_code == 200:
                response.success()
                print("Downloaded Bytes:", len(response.content))
            else:
                response.failure("Download Failed")
